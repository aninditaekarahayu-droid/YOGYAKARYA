INSERT INTO `faq` (`id`, `pertanyaan`, `jawaban`, `urutan`) VALUES
(1, 'Apa wisata paling ikonik di Yogyakarta?', 'Wisata paling ikonik di Yogyakarta adalah Candi Prambanan, Keraton Yogyakarta, dan Jalan Malioboro yang terkenal di seluruh dunia.', 1),
(2, 'Apa oleh-oleh wajib dari Yogyakarta?', 'Oleh-oleh wajib Yogyakarta meliputi Bakpia Pathok, Gudeg kaleng, Yangko, Geplak, Wedang Uwuh, Rujak Es Krim, dan Es Dawet Ayu.', 2),
(3, 'Bagaimana cara memesan produk kami?', 'Kamu bisa memesan produk langsung melalui halaman Produk di website ini, lalu hubungi kami via kontak yang tersedia.', 3),
(4, 'Apa itu game Yodogo?', 'Yodogo adalah board game edukatif bertema budaya Yogyakarta untuk 2-4 pemain. Cocok untuk keluarga dan dimainkan 30-60 menit.', 4),
(5, 'Apa itu Yogyakarya?', 'Yogyakarya adalah portal digital yang menyajikan informasi lengkap tentang Yogyakarta, mulai dari destinasi wisata, warisan budaya, kuliner khas, hingga game edukatif bertema Yogyakarta. Kami juga menyediakan produk oleh-oleh khas yang bisa dipesan langsung.', 5),
(6, 'Apa yang membuat Yogyakarya berbeda dari website wisata lainnya?', 'Yogyakarya menggabungkan informasi wisata dengan pengalaman interaktif melalui game edukatif bertema budaya Yogyakarta, serta kemudahan belanja produk lokal langsung dari website.', 6),
(7, 'Apa wisata paling ikonik di Yogyakarta?', 'Wisata paling ikonik di Yogyakarta adalah Candi Prambanan, Keraton Yogyakarta, Taman Sari, Museum Benteng Vredeburg, dan Jalan Malioboro yang terkenal di seluruh dunia.', 7),
(8, 'Berapa harga tiket masuk Keraton Yogyakarta?', 'Tiket masuk Keraton Yogyakarta untuk wisatawan domestik sekitar Rp15.000-20.000. Harga dapat berubah sewaktu-waktu, disarankan cek informasi terbaru sebelum berkunjung.', 8),
(9, 'Apakah Museum Benteng Vredeburg cocok untuk anak-anak?', 'Sangat cocok! Museum ini menyajikan sejarah kemerdekaan Indonesia dengan display interaktif, diorama menarik, dan edukatif untuk segala usia.', 10);

