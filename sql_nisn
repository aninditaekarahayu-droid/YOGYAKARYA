INSERT INTO `game` (`id`, `nama`, `jenis`, `deskripsi`, `cara_main`, `jumlah_pemain`, `folder_game`, `thumbnail`) VALUES
(1, 'YODOGO (YOGYAKARTA LUDO BINGO)', 'board_game', '\"Jelajahi Sudut Kota, Susun Aksara di Jantung Istimewa.\"\r\n\r\nYODOGO adalah sebuah inovasi board game yang menggabungkan ketegangan strategi Ludo dengan kepuasan mengoleksi dalam Bingo. Berlatar belakang kehangatan budaya Yogyakarta, game ini mengajak pemain berperan sebagai pelancong sekaligus kolektor artefak budaya yang harus berlomba menyelesaikan misi di tengah kota.', '1. Persiapan Permainan (Set-Up):\r\n- Penentuan Urutan: Setiap pemain melempar dadu. Pemain dengan angka dadu tertinggi berhak memulai permainan pertama kali.\r\n- Memilih Ikon: Pemain mengambil satu Kartu Ikon (contoh: BECAK, GUDEG, JOGJA) secara acak yang akan menjadi target \"Bingo\" mereka.\r\n- Persiapan Kartu: Setiap pemain dibekali 10 kartu huruf acak di kotak mereka masing-masing.\r\n\r\n2. Langkah Permainan:\r\n - Lempar Dadu: Jalankan pionmu keliling papan sesuai angka dadu.\r\n - Misi Menuju Base: Fokus utama adalah membawa pion kembali ke Base (Titik Start) untuk mendapatkan hak mengambil kartu.\r\n - Pengambilan Huruf: Saat pion tiba di Base, kamu boleh mengambil satu kartu huruf dari kotak pribadimu.\r\n\r\n3. Mekanik Papan Koleksi & Kartu Buangan:\r\n - Jika Cocok: Apabila huruf yang didapat ada di dalam kata pada Kartu Ikonmu (misal: Ikon BECAK, dapat huruf \'B\'), langsung letakkan di Papan Koleksi.\r\n - Jika Tidak Cocok:  Apabila huruf tidak ada di Kartu Ikonmu (misal: Ikon BECAK, dapat huruf \'T\'), kamu wajib membuangnya ke kotak tengah (Area Kartu Buangan).\r\n - Rebut Kartu Lawan: Jika pemain lain tiba di Base dan melihat ada huruf di \"Area Kartu Buangan\" yang cocok dengan Ikon mereka, mereka boleh mengambilnya daripada mengambil kartu baru dari kotak pribadi.\r\n\r\n4. Kondisi Kemenangan (Sembada):\r\n - Pemain pertama yang berhasil mengisi semua kolom di Papan Koleksi sesuai dengan kata pada Kartu Ikonnya dinyatakan sebagai pemenang utama!', '2 - 4 pemain', '-', '1774749487.jpg'),
(2, 'Jogjaksara', 'digital', 'Game puzzle susun kata 2D bertema kota Yogyakarta. Pemain harus menyusun huruf-huruf yang tersedia untuk membentuk kata-kata yang berhubungan dengan budaya, tempat wisata, kuliner, dan keunikan Jogja.', '-', '-', 'https://drive.google.com/drive/folders/1y6cH8UDv7MSWAjIaUDrpaWnI5erZ3VDl', '1775535685.jpeg');

