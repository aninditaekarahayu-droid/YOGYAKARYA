INSERT INTO `kuliner` (`id`, `nama`, `deskripsi`, `resep`, `gambar`) VALUES
(1, 'Gudeg', 'Gudeg adalah hidangan khas Daerah Istimewa Yogyakarta dan Jawa Tengah, yang terbuat dari nangka muda (gori) yang dimasak dengan santan. Cita rasa dominan pada masakan ini adalah manis.\r\n\r\nsrc: Wikipedia.com', 'Bahan Rebusan Nangka :\r\n750 gr Nangka muda, potong-potong\r\n4 lembar Daun jati\r\n3 lembar Daun salam\r\n2 liter Air\r\n\r\nBumbu Halus :\r\n12 butir Bawang merah\r\n10 siung Bawang putih\r\n4 butir Kemiri\r\n1 sendok makan Ketumbar\r\n\r\nBumbu Cemplung :\r\n100 gram Gula merah\r\n3 lembar Daun salam\r\n1 ruas Lengkuas, dikeprek\r\nSecukupnya Asam jawa\r\n1 sendok makan Garam\r\n1 sendok teh Kaldu ayam bubuk\r\n\r\nBahan Pelengkap :\r\n250 gram Kaki ayam / ceker ayam (saya ganti telur ayam)\r\n500 ml Santan kental\r\n1 liter Air\r\nSecukupnya Daun jati jika ingin warnanya lebih gelap lagi\r\n\r\nCara Pembuatan:\r\n1. Siapkan semua bahan. Gunakan daun jati yang masih muda untuk warna yang lebih pekat / gelap. Jangan di skip daun jati jika ingin hasilnya hitam kemerahan alami.\r\n2. Rebus telur ayam hingga matang. Kupas kulitnya, lalu sisihkan.\r\n3. Siapkan panci / wajan besar. Lebih baik lagi kalau pakai kendil atau periuk yang terbuat dari tanah liat. Tata dasarnya dengan 3 lembar daun jati. Masukkan nangka muda. Tuang air hingga menutupi nangka. Lalu tambahkan daun salam. Tutupi lagi dengan 2 lembar daun jati. Kemudian tutup panci / wajan besar / kendil dan rebus nangka muda hingga empuk agar getahnya keluar.\r\n4. Setelah nangka muda empuk, angkat nangka muda, lalu tiriskan. Buang daun salam, daun jati, dan air rebusan.\r\n5. Haluskan semua bahan bumbu halus. Bisa di ulek, bisa juga diblender.\r\n6. Siapkan panci / wajan besar / kendil. Alasi dasarnya dengan 3 lembar daun jati. Masukkan telur ayam rebus. Lalu masukkan nangka muda, bumbu halus, bumbu cemplung, dan kaki ayam / ceker ayam (jika pakai).\r\n7. Tuang air, aduk rata, lalu tutup dengan 2 lembar daun jati. Kemudian tutup panci / wajan besar / kendil. Setelah itu rebus hingga air menyusut.\r\n8. Setelah air menyusut, buka tutup panci / wajan besar / kendil, dan penutup daun jati. Tuang santan. Masak dengan api kecil sambil sesekali diaduk. Masak hingga kuah menyusut.\r\n9. Angkat kaki ayam / ceker ayam (jika pakai). Kalau ingin gudeg kering, rebus kembali hingga kuahnya asat. Tes rasa.\r\n10. Siap disajikan.\r\n11. Jika ingin dimasukkan ke dalam besek. Alasi besek terlebih dahulu dengan plastik seukuran bagian dalam besek untuk mencegah kuah gudeg bocor atau merembes. Baru alasi daun pisang. Setelah itu, isi dengan gudeg. Tutupi lagi dengan daun pisang. Baru tutup dengan tutup besek. Siap dijadikan hantaran.\r\n\r\nsrc: https://cookpad.com/id/resep/17301947?ref=search&search_term=gudeg+jogja+asli', '1775535497.jpg'),
(2, 'Rujak Es Krim', 'Rujak es krim adalah sebuah jenis rujak khas Yogyakarta yang terbuat dari es krim sebagai toppingnya. Beragam buah yang diserut halus kemudian disiram dengan bumbu rujak pedas dan disajikan bersama es krim tradisional yang terbuat dari santan.\r\n\r\nsrc: Wikipedia.com', 'Bahan:\r\n200 gram nanas, iris korek api\r\n200 gram pepaya mengkal, iris korek api\r\n200 gram mangga muda, iris korek api\r\n200 gram mentimun, buang biji, iris korek api\r\n400 gram gula pasir\r\n1 Â½ l air\r\n600 gram es krim\r\n200 ml Susu Frisian Flag Kental Manis Cokelat\r\n\r\nBumbu Rujak:\r\n5 buah cabai rawit merah\r\nÂ½ sdt terasi goreng\r\n1 sdm asam jawa\r\nÂ¾ sdt garam\r\n2 sdm air jeruk nipis\r\n\r\nCara membuat:\r\nDidihkan air. Masukkan bumbu rujak. Rebus sampai harum.\r\nMasukkan gula pasir, aduk rata. Masak sampai larut. Angkat.\r\nTambahkan nanas, pepaya, mangga, dan mentimun, aduk rata.\r\nMasukkan air jeruk nipis. Dinginkan.\r\nSajikan dengan es krim dan siraman susu Frisian Flag Kental Manis Cokelat.\r\n\r\nsrc: https://www.frisianflag.com/resep-kami/resep-dengan-kental-manis/resep-rujak-es-krim-khas-yogyakarta', '1775535483.webp'),
(3, 'Bakpia', 'Bakpia Jogja adalah oleh-oleh ikonik Yogyakarta berbentuk kue bulat pipih dengan isian manis (kacang hijau, cokelat, keju) yang dipanggang atau dikukus. Bakpia Jogja adalah oleh-oleh ikonik Yogyakarta berbentuk kue bulat pipih dengan isian manis (kacang hijau, cokelat, keju) yang dipanggang atau dikukus.', 'Bahan A: \r\n50 gr tepung terigu protein sedang\r\n50 gr tepung terigu protein tinggi\r\n25 gr Kental Manis Cap Enaak Original\r\n40 ml air\r\n1/2 sdm margarin\r\n40 ml minyak goreng\r\n80 ml minyak goreng untuk rendaman\r\n\r\nBahan B :\r\n50 gr tepung terigu protein sedang\r\n1/2 sdm margarin\r\n25 ml minyak\r\n\r\nBahan isian :\r\n150 gr tepung terigu segitiga biru, bagi 2\r\n1 helai daun pandan\r\nSejumput garam\r\n50 gr Kental Manis Cap Enaak Original\r\n50 gr Kental Manis Cap Enaak Cokelat\r\n80 gr margarin, bagi 2\r\n4 sdm air, bagi 2\r\n50 gr keju parut\r\n\r\nCara Pembuatan:\r\n1. Campur tepung, Kental Manis Cap Enaak Original, margarin, air, minyak dan garam. Uleni hingga rata. Rendam dalam minyak, diamkan 30 menit. Lalu bulatkan, ini sekitar 15gr.\r\n2. Campur semua bahan B, kemudian bulatkan masingÂ² 5 gr.\r\n3. Membuat isian : Sangrai tepung, garam dan daun pandan sampai terasa ringan (bagi 2 sama rata), lalu satu bagian campur dengan Kental Manis Cap Enaak Original dan keju parut. Aduk rata lalu masukkan margarin. Aduk rata lalu tambahkan air.\r\n4. Jika sudah teraduk rata. Bulatkan dan siap dipakai. Untuk isian cokelat sama seperti langkah diatas. Simpan dulu isiannya.\r\n5. Ambil 1 buah bahan A, pipihkan, kemudian timpa dengan bahan B, lipat bentuk amplop, lalu gilas kemudian gulung dan gilas lagi, lakukan sebanyak 3x, kemudian beri isian, & bulatkan kembali.\r\n6. Tata diatas loyang yang sudah dialasi kertas baking. Panggang suhu 180Â° selama 25 menit api atas bawah, kemudian balik, panggang kembali selama 15 menit. Atau sesuaikan oven masing-masing. Jangan lupa panaskan oven 10 menit yaaah.\r\nSetelah dingin, masukkan dalam toples.\r\n\r\nsrc: cookpad.com', '1775535466.jpeg'),
(4, 'Wedang Uwuh', 'Wedang uwuh adalah minuman tradisional khas Yogyakarta yang berarti \"minuman sampah\" (wedang = minuman, uwuh = sampah) karena terdiri dari campuran berbagai rempah-rempah alami yang terlihat seperti tumpukan sampah saat diseduh, seperti jahe, kayu secang, kayu manis, dan sereh. Minuman hangat ini berwarna merah alami dari kayu secang dan dipercaya berkhasiat untuk meningkatkan daya tahan tubuh, mengurangi asam urat, dan mengatasi kembung.', 'Bahan: \r\n1 ruas jahe (saya jahe merah)\r\n2 lembar kulit secang\r\n3 helai daun pala\r\n2 helai daun cengkeh\r\n5 buah cengkeh (saya tidak pakai)\r\n2-3 cm kayu manis\r\n2 gelas air\r\n\r\nCara Pembuatan:\r\n1. Siapkan bahan-bahan.\r\n2. Cuci bersih jahe dan digeprek (bisa juga dibakar dahulu), rebus dengan air kurang lebih 2 gelas.\r\n3. Tambahkan bahan lainnya. Rebus hingga airnya berubah menjadi warna merah.\r\n4. Saring. Diminum saat hangat.\r\n\r\nsrc: cookpad.com', '1775535329.webp');

